# Dropship Desk — copy to .env and edit. Masters default OFF.

# Amazon write automation (cart / purchase). Keep false until ready.
AMAZON_AUTOMATION_ENABLED=false
AMAZON_ALLOW_CART=false
AMAZON_ALLOW_PURCHASE=false

# eBay write automation (list / tracking / publish). Keep false until ready.
EBAY_AUTOMATION_ENABLED=false
EBAY_ALLOW_LIST=false
EBAY_ALLOW_TRACKING=false
EBAY_AUTO_PUBLISH=false

# Live upload master switch. Keep false: first live use is a separate operator
# decision. Live also needs the production account connected and both
# EBAY_AUTOMATION_ENABLED=true and EBAY_ALLOW_LIST=true.
EBAY_LIVE_UPLOAD_ENABLED=false
# Live batch cap (default 5, hard ceiling 50 in code).
EBAY_LIVE_MAX_PER_RUN=5

# sandbox | production — default target on first launch. Settings can switch without restart.
# Live Send/Publish still needs EBAY_AUTOMATION_ENABLED=true and EBAY_ALLOW_LIST=true.
EBAY_ENV=sandbox

EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_DEV_ID=
EBAY_SANDBOX_CERT_ID=
# RuName from developer.ebay.com. Auth accepted URL must be:
# https://127.0.0.1:8770/api/ebay/oauth/callback
# Sandbox: Settings → Sandbox → Connect sandbox eBay → Evaluate → Send unpublished offer → Publish.
# Live: fill EBAY_PROD_* keys, set EBAY_AUTOMATION_ENABLED=true and EBAY_ALLOW_LIST=true,
# then Settings → Live eBay → Connect live eBay. Same Send/Publish clicks; live asks for confirm.
EBAY_SANDBOX_RUNAME=

EBAY_PROD_APP_ID=
EBAY_PROD_DEV_ID=
EBAY_PROD_CERT_ID=
EBAY_PROD_RUNAME=

# sparky2 Ollama (note: this machine uses port 11435)
OLLAMA_BASE_URL=http://192.168.0.72:11435
OLLAMA_MODEL=agents-a1-nonthink

# Optional
# DROPSHIP_PORT=8770
# DROPSHIP_DATA_DIR=
