# Dropship Desk — copy to .env and edit. Masters default OFF.

# Amazon write automation (cart / purchase). Keep false until ready.
AMAZON_AUTOMATION_ENABLED=false
AMAZON_ALLOW_CART=false
AMAZON_ALLOW_PURCHASE=false

# eBay write automation (list / tracking / publish). Keep false until ready.
EBAY_AUTOMATION_ENABLED=false
EBAY_ALLOW_LIST=false
EBAY_ALLOW_TRACKING=false
EBAY_AUTO_PUBLISH=false

# sandbox | production
EBAY_ENV=sandbox

EBAY_SANDBOX_APP_ID=
EBAY_SANDBOX_DEV_ID=
EBAY_SANDBOX_CERT_ID=
# RuName from developer.ebay.com. Auth accepted URL must be:
# https://127.0.0.1:8770/api/ebay/oauth/callback
# Sandbox: Connect eBay then use Evaluate → Send unpublished offer → Publish.
# Production also needs EBAY_AUTOMATION_ENABLED=true and EBAY_ALLOW_LIST=true.
EBAY_SANDBOX_RUNAME=

EBAY_PROD_APP_ID=
EBAY_PROD_DEV_ID=
EBAY_PROD_CERT_ID=
EBAY_PROD_RUNAME=

# sparky2 Ollama (note: this machine uses port 11435)
OLLAMA_BASE_URL=http://192.168.0.72:11435
OLLAMA_MODEL=agents-a1-nonthink

# Optional
# DROPSHIP_PORT=8770
# DROPSHIP_DATA_DIR=
